# Wazuh all-in-one server (manager, indexer, dashboard) in a private subnet

data "aws_ssm_parameter" "ubuntu" {
  name = "/aws/service/canonical/ubuntu/server/24.04/stable/current/amd64/hvm/ebs-gp3/ami-id"
}

resource "aws_sns_topic" "alerts" {
  name = "wazuh-alerts"
}

resource "aws_sns_topic_subscription" "email" {
  topic_arn = aws_sns_topic.alerts.arn
  protocol  = "email"
  endpoint  = var.alert_email
}

# Created with a placeholder; the instance stores the password generated by the installer
resource "aws_ssm_parameter" "admin_password" {
  name  = "/wazuh/admin-password"
  type  = "SecureString"
  value = "pending"

  lifecycle {
    ignore_changes = [value]
  }
}

resource "aws_iam_role" "wazuh" {
  name = "wazuh-manager"
  assume_role_policy = jsonencode({
    Version   = "2012-10-17"
    Statement = [{ Effect = "Allow", Action = "sts:AssumeRole", Principal = { Service = "ec2.amazonaws.com" } }]
  })
}

resource "aws_iam_role_policy_attachment" "wazuh_ssm" {
  role       = aws_iam_role.wazuh.name
  policy_arn = "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
}

resource "aws_iam_role_policy" "wazuh" {
  name = "wazuh-manager"
  role = aws_iam_role.wazuh.id
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      { Sid = "ReadCloudTrail", Effect = "Allow", Action = ["s3:GetObject", "s3:ListBucket"], Resource = [aws_s3_bucket.trail.arn, "${aws_s3_bucket.trail.arn}/*"] },
      { Sid = "PublishAlerts", Effect = "Allow", Action = "sns:Publish", Resource = aws_sns_topic.alerts.arn },
      { Sid = "StoreAdminPassword", Effect = "Allow", Action = "ssm:PutParameter", Resource = aws_ssm_parameter.admin_password.arn },
    ]
  })
}

resource "aws_iam_instance_profile" "wazuh" {
  name = "wazuh-manager"
  role = aws_iam_role.wazuh.name
}

resource "aws_security_group" "wazuh" {
  name        = "wazuh-manager"
  description = "Agent traffic from the monitored VPCs only"
  vpc_id      = module.network.vpc_id

  ingress {
    description = "Wazuh agent events (1514) and enrollment (1515)"
    from_port   = 1514
    to_port     = 1515
    protocol    = "tcp"
    cidr_blocks = [local.cidrs.development, local.cidrs.production]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

resource "aws_instance" "wazuh" {
  ami                    = data.aws_ssm_parameter.ubuntu.insecure_value
  instance_type          = "t3.xlarge"
  subnet_id              = module.network.private_subnet_id
  vpc_security_group_ids = [aws_security_group.wazuh.id]
  iam_instance_profile   = aws_iam_instance_profile.wazuh.name

  user_data_replace_on_change = true
  user_data = templatefile("${path.module}/templates/wazuh-manager.sh.tftpl", {
    wazuh_minor        = join(".", slice(split(".", var.wazuh_version), 0, 2))
    region             = var.region
    trail_bucket       = aws_s3_bucket.trail.id
    organization_id    = data.aws_organizations_organization.current.id
    password_parameter = aws_ssm_parameter.admin_password.name
    alert_group        = "custom_detections"
    sns_script         = file("${path.module}/../wazuh/integrations/custom-sns.py")
    sns_config = jsonencode({
      topic_arn = aws_sns_topic.alerts.arn
      region    = var.region
      accounts = [
        { id = data.aws_caller_identity.current.account_id, name = "management" },
        { id = var.development_account_id, name = "development" },
        { id = var.production_account_id, name = "production" },
      ]
    })
  })

  metadata_options {
    http_tokens = "required"
  }

  root_block_device {
    volume_size = 50
    volume_type = "gp3"
    encrypted   = true
  }

  lifecycle {
    ignore_changes = [ami] # a newer Ubuntu AMI must not replace the server mid-project
  }

  tags = { Name = "wazuh-manager" }
}
